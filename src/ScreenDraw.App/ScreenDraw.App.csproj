<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ScreenDraw.App</RootNamespace>
    <AssemblyName>ScreenDraw</AssemblyName>
    <Version>0.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\screen-draw.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\screen-draw.ico" LogicalName="ScreenDraw.app.ico" />
    <EmbeddedResource Include="..\..\assets\screen-draw-tray.ico" LogicalName="ScreenDraw.tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenDraw.Core\ScreenDraw.Core.csproj" />
  </ItemGroup>

</Project>
